{
  "name": "code-replay",
  "version": "0.1.0",
  "description": "Terminal tool that tracks your local git commits and reports lines added/removed, authors, languages and activity over time.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "git",
    "cli",
    "stats",
    "commits",
    "loc",
    "lines-of-code",
    "terminal",
    "analytics"
  ],
  "bin": {
    "code-replay": "dist/cli.js",
    "cr": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "execa": "^9.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
